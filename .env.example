# Vigil environment variables — all optional unless noted.

# Network for Altana sessions. MAINNET is the default; only set this to opt
# into testnet (e.g. local development). No hostname heuristics anywhere.
# NEXT_PUBLIC_ALTANA_CHAIN=mainnet

# Postgres URL. REQUIRED on Vercel — without it the app runs non-persistent.
# Locally, an ephemeral tmp file store is used when unset.
# DATABASE_URL=postgres://user:pass@host:5432/vigil

# AES-256-GCM key for encrypting agent session keys at rest. SET IN PRODUCTION.
# A dev-only key is used (with a warning) if unset.
# MANDATE_ENCRYPTION_KEY=<32+ byte secret>

# Protects privileged endpoints (?op=verify, confirm=1).
# AGENT_RUN_KEY=<secret>

# Override the measured 8004scan budgets (defaults: 180/min, 20000/day).
# RATE_LIMIT_PER_MIN=180
# RATE_LIMIT_PER_DAY=20000

# pino log level: trace | debug | info | warn | error
# LOG_LEVEL=info
